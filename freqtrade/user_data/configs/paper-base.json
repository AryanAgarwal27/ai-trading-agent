{
    // Stage 7 paper-trading base config. paper_spawn (lands in 7c)
    // deep-merges this with per-strategy fields (pair_whitelist, strategy
    // class name, stake_amount per LIVE_CAPITAL_CAP_USD / max_open_trades,
    // timeframe, freqai block if applicable) and writes the result to
    // freqtrade/user_data/configs/config-paper-<strategy_id>.json.
    //
    // Anything in this file is the contract surface. Don't edit per-strategy
    // values here — pass them through paper_spawn's merge.
    //
    // Freqtrade accepts // and /* */ comments in JSON configs.

    "dry_run": true,
    "dry_run_wallet": 1000,
    "stake_currency": "USDT",
    "stake_amount": 100,
    "max_open_trades": 4,
    "tradable_balance_ratio": 1.0,
    "trading_mode": "spot",
    "margin_mode": "",
    "cancel_open_orders_on_exit": false,

    // BRD §11 in-container safety net: a MaxDrawdown `protections` entry.
    // It is NOT here by design. Freqtrade 2026.4 deprecated config-level
    // `protections` — the stable_freqai image REJECTS it at container boot
    // ("DEPRECATED: Setting 'protections' in the configuration is
    // deprecated") and ignores config entries even when present. The
    // canonical (and only supported) location is the strategy's
    // `protections` @property, so the identical MaxDrawdown net now lives on
    // each template class in strategy_templates/ and is carried into every
    // generated strategy. The orchestrator-side paper_monitor (Stage 7d+)
    // plus the out-of-band APScheduler kill switch remain the authoritative
    // enforcers of the BRD §11 layered safeguards.

    // pair_whitelist intentionally empty; paper_spawn fills from state.pairs.
    // SPEC §1 Q2 universe is BTC/USDT, ETH/USDT, SOL/USDT, BNB/USDT — the
    // strategy proposal picks a subset.
    "exchange": {
        "name": "binance",
        "key": "${BINANCE_PAPER_API_KEY}",
        "secret": "${BINANCE_PAPER_API_SECRET}",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [],
        // pair_blacklist intentionally empty: SPEC §1 Q2 v1 pair list
        // includes BNB/USDT (no exchange-side conflict on Binance spot;
        // the historical BNB-stake fee-discount caveat applies to the
        // BNB stake currency, not the BNB/USDT pair). Per-strategy
        // blacklist additions belong in paper_spawn's deep-merge, not
        // the contract base.
        "pair_blacklist": []
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],

    "api_server": {
        "enabled": true,
        // Listens on 0.0.0.0 INSIDE the container; the host-side mapping
        // in docker-compose.freqtrade.yml is 127.0.0.1:${PAPER_PORT}:8080,
        // which is the real network boundary (BRD §15).
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "${PAPER_API_PASSWORD}",
        "ws_token": "${PAPER_API_PASSWORD}",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "${PAPER_API_PASSWORD}"
    },

    "bot_name": "${STRATEGY_ID}",

    "initial_state": "running",
    "force_entry_enable": false,

    "internals": {
        "process_throttle_secs": 5
    },

    // Logging — paper_spawn appends a strategy-specific suffix; this is
    // the default that applies if not overridden.
    "logfile": "/freqtrade/user_data/logs/freqtrade.log"
}
