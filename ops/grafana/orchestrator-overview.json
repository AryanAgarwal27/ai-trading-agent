{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the orchestrator /metrics endpoint.",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "11.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "title": "ai-trading-agent — Orchestrator Overview",
  "uid": "ait-orchestrator-overview",
  "tags": ["ai-trading-agent", "orchestrator", "BRD-14"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "timezone": "utc",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Kill-switch fires (total)",
      "description": "ait_kill_switch_fires_total — cumulative out-of-band kill-switch events the orchestrator consumed (BRD §11, §5.6). A nonzero value means at least one live thread was halted and routed to live_pause.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "ait_kill_switch_fires_total", "legendFormat": "fires" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Kill-switch fire rate",
      "description": "rate(ait_kill_switch_fires_total[5m]) — fires per second over a 5m window; a spike is an incident signal.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 }, "unit": "ops" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(ait_kill_switch_fires_total[5m])", "legendFormat": "fires/s" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Strategies by lifecycle stage",
      "description": "ait_strategies_by_stage — count of strategy threads per BRD §5.7 lifecycle stage (research → … → archived). Watch the funnel: paper/live counts are the working capital surface.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "stacking": { "mode": "normal" }, "fillOpacity": 30 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "ait_strategies_by_stage", "legendFormat": "{{stage}}" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Supervisor runs by trigger",
      "description": "rate(ait_supervisor_runs_total[1h]) — supervisor invocations per second by trigger (cron / event / manual). Flatlining cron = the nightly job stopped firing.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 60 }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "rate(ait_supervisor_runs_total[1h])", "legendFormat": "{{trigger}}" }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Freqtrade containers up",
      "description": "sum(ait_freqtrade_up) / count(ait_freqtrade_up) — how many running paper/live containers answered their last scrape. A drop means a container is unreachable (the on-startup reconciler / kill path acts on live ones).",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "sum(ait_freqtrade_up)", "legendFormat": "containers up" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" }, "expr": "count(ait_freqtrade_up)", "legendFormat": "containers total" }
      ]
    }
  ]
}
